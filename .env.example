# Production shell runs only against the Kiwoom mock environment.
# The loader accepts either the canonical mode key or the existing legacy flag.
TRADING_MODE=KIWOOM_MOCK
# KIWOOM_MOCK=true

# Both credential naming contracts are supported.
KIWOOM_MOCK_APP_KEY=
KIWOOM_MOCK_SECRET_KEY=
# KIWOOM_APP_KEY=
# KIWOOM_SECRET_KEY=

KIWOOM_ACCOUNT=

# Optional overrides. Defaults are already compiled into RuntimeConfig.
# KIWOOM_REST_BASE_URL=https://mockapi.kiwoom.com
# KIWOOM_WEBSOCKET_URL=wss://mockapi.kiwoom.com:10000/api/dostk/websocket
